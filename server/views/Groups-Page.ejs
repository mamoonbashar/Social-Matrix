<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/CSS/Group.css" />
    <title>Groups</title>
  </head>
  <body>
    <%- include('partials/navbar.ejs')%>
    <main>
      <%- include('partials/sidebar.ejs')%>
      <section class="membersFilterContainers">
        <section class="membersContainer">
          <section class="memberHeadingContainer">
            <h4>Groups</h4>
          </section>
          <section class="navigationBar">
            <ul class="navigationbtn">
              <li>
                All
                <div class="underLine"></div>
              </li>

              <li>
                My Connections
                <div class="underLine"></div>
              </li>
              <li>
                Followers
                <div class="underLine"></div>
              </li>

              <li>
                Following
                <div class="underLine"></div>
              </li>
            </ul>
          </section>
          <section class="memberCountContainer">
            <section class="membersCount">
              <p>0 <span>Members</span></p>
            </section>
            <section class="recentlyActiveContainer">
              <p>Recenetly Active</p>
            </section>
          </section>

          <section class="memberCardsContainer">
            <section class="Card">
              <section class="CardImage"></section>
              <section class="cardDetails">
                <section class="dpSquare"></section>
                <section class="GroupName"></section>
                <section class="UserImageNameContainer">
                  <secton class="UserImageContainer">
                    <section class="userImageCircle"></section>
                    <section class="userImageCircle"></section>
                    <section class="userImageCircle"></section>
                  </secton>
                  <section class="UserNameContainer"></section>
                </section>
              </section>
            </section>
            <section class="Card"></section>
            <section class="Card"></section>
            <section class="Card"></section>
            <section class="Card"></section>
          </section>
        </section>

        <section class="members-groups-filter-container">
          <section class="membersCard">
            <section class="headingContainer">
              <h4>Members</h4>
            </section>
            <section class="navigationOptions">
              <p>Interest</p>
              <p>Active</p>
              <p>Popular</p>
            </section>
            <section class="members-container">
              <section class="memberbar">
                <section class="circle"></section>
                <section class="userName"></section>
              </section>
              <section class="memberbar">
                <section class="circle"></section>
                <section class="userName"></section>
              </section>
              <section class="memberbar">
                <section class="circle"></section>
                <section class="userName"></section>
              </section>
            </section>
            <section class="viewAll">View All</section>
          </section>

          <section class="membersCard">
            <section class="headingContainer">
              <h4>Members</h4>
            </section>
            <section class="navigationOptions">
              <p>Interest</p>
              <p>Active</p>
              <p>Popular</p>
            </section>
            <section class="members-container">
              <section class="memberbar">
                <section class="circle"></section>
                <section class="userName"></section>
              </section>
              <section class="memberbar">
                <section class="circle"></section>
                <section class="userName"></section>
              </section>
              <section class="memberbar">
                <section class="circle"></section>
                <section class="userName"></section>
              </section>
            </section>
            <section class="viewAll">View All</section>
          </section>
        </section>
      </section>
    </main>
  </body>
</html>
