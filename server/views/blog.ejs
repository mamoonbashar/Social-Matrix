<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog</title>
    <link rel="stylesheet" href="/CSS/blog.css" />
  </head>
  <body>
    <%- include('partials/navbar.ejs') %>
    <main>
      <%- include('partials/sidebar.ejs') %>
      <section class="masterContainer">
        <section class="websiteBanner">
          <section class="websiteName">
            <h3>Welcome To Message.com</h3>
            <h4>Launch your community today with Message.com; get it now!</h4>
          </section>
          <section class="illustration"><img src="/Illustrations/5235.jpg" alt="" /></section>
        </section>

        <section class="AllBlogsAboutBlog">
          <section class="AllBlogs">
            <section class="blogsContainer">
              <section class="blogImageContainer">
                <img src="" alt="" />
              </section>
              <section class="blogInfoContainer">
                <section class="infoCotainerHeading">
                  <h3>Tackle Your Closet Spring Cleaning</h3>
                  <p>
                    Lorem ipsum dolor sit amet consectetur adipisicing elit.
                    Molestiae fugiat veritatis eum mollitia at ullam in
                    obcaecati itaque.
                  </p>
                </section>
                <section class="userDetailsContainer">
                  <section class="userdpNameContainer">
                    <section class="dpCircle"><img src="" alt="" /></section>

                    <p>John</p>
                    <p>Date</p>
                  </section>
                  <section class="CommentsContainer">
                    <i
                      class="fa-regular fa-message fa-sm"
                      style="color: #9e9e9e"
                    ></i>
                    <p>Comment Count</p>
                  </section>
                </section>
              </section>
            </section>
          </section>
          <section class="aboutBlog"></section>
        </section>
      </section>
    </main>
  </body>
</html>
