<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title></title>
    <link rel="stylesheet" href="/CSS/Navbar.css" />
  </head>
  <body>
    <nav class="Nav">
      <section class="Nav__LogoContainer">
        <img src="assets/Productlogo.png" alt="BrandLogo" />
        <p>Message.com</p>
      </section>
      <section class="Nav__NavIconsContainer">
        <i class="fa-solid fa-chart-line fa-lg"></i>
        <a href="/members" class="tooltip">
          <i class="fa-solid fa-user fa-lg"></i>
          <span class="tooltipText">Members</span>
        </a>
        <a href="/groups" class="tooltip">
          <i class="fa-solid fa-people-group fa-lg"></i>
          <span class="tooltipText">Groups</span>
        </a>
        <a href="/message" class="tooltip">
          <i class="fa-regular fa-message fa-lg"></i>
          <span class="tooltipText">Message</span>
        </a>
        <a href="/forums"class="tooltip">
          <i class="fa-regular fa-file fa-lg"></i>
          <span class="tooltipText">Forums</span>
        </a>
      </section>
      <section class="Nav__NavIconsContainer2">
        <i class="fa-solid fa-magnifying-glass fa-lg"></i>
        <i class="fa-solid fa-bell fa-lg"></i>
        <div class="AccountIdContainer">
          <p>Name</p>
          <div class="ProfileCircle">
            <img
              src="/assets/UsersImage/young-bearded-man-with-striped-shirt_273609-5677.avif"
              alt="logo"
            />
          </div>
        </div>
      </section>
    </nav>
    <script
      src="https://kit.fontawesome.com/5e42a819a3.js"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
